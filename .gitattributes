# Append-only ledger: union entries added by parallel agents (scripts/merge-ledger.py).
.agents/evidence.json merge=ledger
# Roadmap narratives: merged per vector id, so two agents editing
# different vectors never conflict (scripts/merge-roadmap.py).
.agents/roadmap.json merge=roadmap
# Legacy source evidence merges remain compatible. New operational records
# use ignored local snapshots and never append to these historical files.
.agents/gmcp/evidence/*.jsonl merge=union
# Classify vendored dependencies, generated/append-only agent records, and docs
# separately from first-party runtime Rust while preserving offline builds and auditability.
vendor/** linguist-vendored
.agents/** linguist-generated
docs/** linguist-documentation
