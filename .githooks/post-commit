#!/usr/bin/env bash
# A commit returns at once: nothing here waits on the network or rewrites the
# branch. Keeping the primary checkout's main current is a throttled background
# fetch (sync-primary). A branch is reconciled with origin/main when it is
# published (`local-snapshot submit` composes it with the current main), never
# by an automatic merge after each commit: that merge cost a fetch per commit
# and pulled unqualified main into release branches.
"$(dirname "$0")/sync-primary"
# A worktree whose target/ is still a link to the clone's old shared target
# gets one of its own at once. Git runs no post-merge for a merge that stops
# on conflicts: the commit that concludes it (`git commit`, `git merge
# --continue`) runs this hook and no other, and the plain cargo that comes
# next must not build where a sibling's build can stand in for this branch's.
# The link only is removed, now; the snapshot is copied in the background
# (scripts/seed-target.sh --background). Silent, and free, otherwise.
top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
if [ -L "$top/target" ] && [ -f "$top/scripts/seed-target.sh" ]; then
    (
        unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR
        "${BASH:-bash}" "$top/scripts/seed-target.sh" --background "$top" </dev/null
    ) || true
fi
exit 0
