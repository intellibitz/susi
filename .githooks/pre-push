#!/usr/bin/env bash
# 🛡️ SUSI Pre-Push Safety Guard
# Requires a version bump for any push that touches engine source (src/),
# so every pushed change to the engine is uniquely addressable. Pushes that
# only touch non-src files (docs, config, etc.) are exempt.

echo "🛡️ Running SUSI Deep Compliance Checks (Deferred from Commit)..."

echo "- Checking Clippy lints..."
cargo clippy --workspace --all-targets -- -D warnings
if [ $? -ne 0 ]; then
    echo "❌ Compliance Violation: Clippy found warnings/errors."
    echo "👉 Fix the clippy issues before pushing."
    exit 1
fi

echo "- Running SUSI Mandate Compliance Auditor..."
cargo run -- admin audit
if [ $? -ne 0 ]; then
    echo "❌ Compliance Violation: SUSI Bloat/Security Audit failed."
    exit 1
fi

# 1. Sync All Manifests (Ensure internal consistency)
# This uses Cargo.toml as the source of truth and updates README/PROJECTS.md
cargo run -- admin sync >/dev/null 2>&1

# 2. Get the version from the local Cargo.toml
LOCAL_VERSION=$(grep '^version =' Cargo.toml | head -n 1 | cut -d '"' -f 2)

# 3. Get the version from the remote (origin/main)
# We fetch first to ensure we have the latest remote state
git fetch origin main >/dev/null 2>&1
REMOTE_VERSION=$(git show origin/main:Cargo.toml | grep '^version =' | head -n 1 | cut -d '"' -f 2)

echo "🛡️ SUSI Versioning Check: Local v$LOCAL_VERSION vs Remote v$REMOTE_VERSION"

# 4. Only require a version bump when this push actually changes engine
# source. A push whose diff against origin/main never touches src/ (e.g.
# README/docs-only changes) is exempt from the bump requirement.
TOUCHES_SRC=$(git diff --name-only origin/main..HEAD -- src/ crates/ 2>/dev/null | head -n 1)

if [[ -n "$TOUCHES_SRC" && "$LOCAL_VERSION" == "$REMOTE_VERSION" ]]; then
    echo "❌ Compliance Violation: Source code (src/ or crates/) changed but version was not incremented."
    echo "👉 Please increment version in Cargo.toml manually before pushing."
    exit 1
fi

# 5. Verify Documentation Alignment
README_VERSION=$(grep 'badge/version-v' README.md | sed -n 's/.*version-v\([0-9.]*\)-.*/\1/p')
if [[ "$LOCAL_VERSION" != "$README_VERSION" ]]; then
    echo "❌ Compliance Violation: README.md version ($README_VERSION) does not match Cargo.toml ($LOCAL_VERSION)."
    echo "👉 Running 'susi admin sync'..."
    cargo run -- admin sync
    exit 1
fi

echo "✅ SUSI Compliance Check Passed."
exit 0
