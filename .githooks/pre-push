#!/usr/bin/env bash
# 🛡️ SUSI Pre-Push Safety Guard
#
# Does NOT require a version bump on every push. It used to: any push
# touching src/ or crates/ had to bump Cargo.toml's version versus
# origin/main, which produced 30+ "chore: bump version ... for compliance
# check" commits with a version number that meant nothing (just an
# incrementing counter) and, critically, was never connected to a git tag -
# release.yml only builds/publishes on a pushed `v*.*.*` tag, and nothing
# ever pushed one automatically, so GitHub's actual Releases page stayed
# frozen at whatever was last tagged by hand while Cargo.toml kept racing
# ahead internally. Cutting a real, tagged release is now a deliberate,
# atomic action - `susi admin release --cut <patch|minor|major>` - which
# bumps every engine Cargo.toml, syncs docs, commits, tags, and pushes the
# tag together in one step, so the tag can never again drift from the
# version. Routine pushes just need to build and pass the checks below.

echo "🛡️ Running SUSI Deep Compliance Checks (Deferred from Commit)..."

# Fast path: only run the Rust-specific checks below if this push actually
# changes Rust/Cargo files relative to what's already on origin/main - a
# docs/config/CI-only push (e.g. deny.toml, install.sh, workflow YAML) gets
# no benefit from clippy or the admin audit re-checking source that never
# changed. Mirrors the pre-commit hook's own fast path.
PUSHED_RUST_FILES=$(git diff --name-only origin/main..HEAD -- '*.rs' 'Cargo.toml' 'Cargo.lock' 2>/dev/null | head -n 1)

if [ -n "$PUSHED_RUST_FILES" ]; then
    echo "- Checking Clippy lints..."
    cargo clippy --workspace --all-targets -- -D warnings
    if [ $? -ne 0 ]; then
        echo "❌ Compliance Violation: Clippy found warnings/errors."
        echo "👉 Fix the clippy issues before pushing."
        exit 1
    fi

    # `admin audit` recruits a live LLM agent swarm (real inference, not a
    # static check) - under CPU contention (e.g. the background daemon
    # running its own missions) it can idle-watchdog-stall for minutes
    # rather than fail cleanly, which previously blocked pushing
    # indefinitely on an environmental issue that says nothing about
    # whether *this push* is compliant. A timeout distinguishes "the audit
    # ran and found a real problem" (still blocks the push) from "the audit
    # itself couldn't complete in a reasonable time" (warns and lets the
    # push proceed - CI's own Test workflow still re-verifies on a clean
    # runner regardless).
    echo "- Running SUSI Mandate Compliance Auditor (120s budget)..."
    timeout 120s cargo run -- admin audit
    AUDIT_STATUS=$?
    if [ "$AUDIT_STATUS" -eq 124 ]; then
        echo "⚠️  Compliance Auditor did not complete within 120s (likely environmental"
        echo "    resource contention, not a code issue) - proceeding without blocking."
        echo "    CI's Test workflow will still verify this push independently."
    elif [ "$AUDIT_STATUS" -ne 0 ]; then
        echo "❌ Compliance Violation: SUSI Bloat/Security Audit failed."
        exit 1
    fi
else
    echo "⏭️ No Rust/Cargo files in this push, skipping Clippy and Audit checks."
fi

# Documentation-alignment safety net only - not a version-bump requirement.
# In normal operation this can't drift: the only thing that ever changes
# the version is `admin release --cut`, which syncs docs to it atomically
# in the same commit. A mismatch here means someone hand-edited Cargo.toml's
# version outside that path; warn loudly rather than silently rewriting
# files mid-push (which would need its own commit anyway) or blocking an
# otherwise-unrelated push on it.
LOCAL_VERSION=$(grep '^version =' Cargo.toml | head -n 1 | cut -d '"' -f 2)
README_VERSION=$(grep 'badge/version-v' README.md | sed -n 's/.*version-v\([0-9.]*\)-.*/\1/p')
if [[ "$LOCAL_VERSION" != "$README_VERSION" ]]; then
    echo "⚠️  README.md version ($README_VERSION) does not match Cargo.toml ($LOCAL_VERSION)."
    echo "    Run 'cargo run -- admin sync', commit the result, and push again."
fi

echo "✅ SUSI Compliance Check Passed."
exit 0
