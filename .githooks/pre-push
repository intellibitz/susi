#!/bin/sh
# Git's compatibility boundary only. All policy lives in the native Rust tool:
# transport safety (no force, no unsafe deletion, real ancestry), no tests, no
# network. Core's tools, push-policy among them, are built from Susi Commercial
# Apps (tools/core-xtask) since 2026-11-19. It is looked for in order:
# push-policy on PATH, else this checkout's earlier build, else a build in a
# Susi Commercial Apps checkout beside this one, else it is built once there
# (offline) and used from then on. With no such checkout beside this one, or a
# tool that cannot be built, the push is refused (it fails closed).
if command -v push-policy >/dev/null 2>&1; then
    exec push-policy "$@"
fi
top=$(git rev-parse --show-toplevel) || exit 1
for bin in "$top/target/debug/push-policy" "$top/target/debug/push-policy.exe" \
    "$top/target/release/push-policy" "$top/target/release/push-policy.exe"; do
    [ -x "$bin" ] && exec "$bin" "$@"
done
tools=
for manifest in "$top"/../*/tools/core-xtask/Cargo.toml; do
    [ -f "$manifest" ] || continue
    tools=$(dirname "$manifest")
    for bin in "$tools/target/debug/push-policy" "$tools/target/debug/push-policy.exe" \
        "$tools/target/release/push-policy" "$tools/target/release/push-policy.exe"; do
        [ -x "$bin" ] && exec "$bin" "$@"
    done
done
if [ -z "$tools" ]; then
    echo "pre-push: push-policy is not on PATH and no Susi Commercial Apps checkout is beside this one; refusing the push (transport safety)" >&2
    exit 1
fi
echo "pre-push: building push-policy once in $tools" >&2
(cd "$tools" && cargo build --offline --locked --quiet --bin push-policy </dev/null >&2) || {
    echo "pre-push: push-policy could not be built; refusing the push (transport safety)" >&2
    exit 1
}
for bin in "$tools/target/debug/push-policy" "$tools/target/debug/push-policy.exe"; do
    [ -x "$bin" ] && exec "$bin" "$@"
done
echo "pre-push: push-policy missing after build; refusing the push" >&2
exit 1
