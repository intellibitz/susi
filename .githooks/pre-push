#!/usr/bin/env bash
# 🛡️ SUSI Pre-Push Safety Guard
#
# Does NOT require a version bump on every push. It used to: any push
# touching src/ or crates/ had to bump Cargo.toml's version versus
# origin/main, which produced 30+ "chore: bump version ... for compliance
# check" commits with a version number that meant nothing (just an
# incrementing counter) and, critically, was never connected to a git tag -
# release.yml only builds/publishes on a pushed `v*.*.*` tag, and nothing
# ever pushed one automatically, so GitHub's actual Releases page stayed
# frozen at whatever was last tagged by hand while Cargo.toml kept racing
# ahead internally. Cutting a real, tagged release is now a deliberate,
# atomic action - `susi admin release --cut <patch|minor|major>` - which
# bumps every engine Cargo.toml, syncs docs, commits, tags, and pushes the
# tag together in one step, so the tag can never again drift from the
# version. Routine pushes just need to build and pass the checks below.

# Mandate 49 (stdin carries the pushed refs; the guard must consume it first).
pushed_refs=$(cat)
printf '%s\n' "$pushed_refs" | "$(dirname "$0")/workflow-guard" push || exit 1
# Queue/lease transactions push blobs, not code. Running cargo here would
# block lease renewal behind the very build whose ownership it protects.
# A queue request (refs/heads/susi-queue/*, scripts/queue-relay.py) is such a
# transaction too: a branch in name only, carrying a refused push of the
# queue's refs for the relay workflow to replay.
if ! printf '%s\n' "$pushed_refs" | grep ' refs/heads/' | grep -qv ' refs/heads/susi-queue/'; then
    exit 0
fi
"$(dirname "$0")/sync-primary"

echo "🛡️ Running SUSI Deep Compliance Checks (Deferred from Commit)..."

# Fast path: only run the Rust-specific checks below if this push actually
# changes Rust/Cargo files relative to what's already on origin/main - a
# docs/config/CI-only push (e.g. deny.toml, install.sh, workflow YAML) gets
# no benefit from clippy or the admin audit re-checking source that never
# changed. Mirrors the pre-commit hook's own fast path. config/ and deploy/
# count: crates compile their files in (include_str!), so a push that renames
# or deletes one breaks a build no .rs change shows.
PUSHED_RUST_FILES=$(git diff --no-renames --name-only origin/main..HEAD -- '*.rs' 'Cargo.toml' 'Cargo.lock' 'config/' 'deploy/' 2>/dev/null | head -n 1)

if [ -n "$PUSHED_RUST_FILES" ]; then
    okfile="$(git rev-parse --git-dir)/susi-gate-ok"
    helper="$(git rev-parse --show-toplevel)/scripts/gate-input-stamp.sh"
    stamp=
    if [ -x "$helper" ]; then stamp=$("$helper") || stamp=; fi
    if [ "${SUSI_RELEASE_PUSH:-}" = 1 ] && [ -z "${SUSI_GATE_NOCACHE:-}" ]; then
        echo "⏭️ Release verification is handled by the local gate or the tagged GitHub checks."
    elif [ "${SUSI_BRANCH_CI_HANDOFF:-0}" = 1 ]; then
        if "${BASH:-bash}" "$(git rev-parse --show-toplevel)/scripts/ci-branch-handoff.sh"; then
            echo "⏭️ Clippy and affected tests are pending in the required GitHub branch check."
        else
            echo "❌ The GitHub branch-test handoff is no longer valid; rerun finish with the local gate." >&2
            exit 1
        fi
    elif [ -n "$stamp" ] && [ -z "${SUSI_GATE_NOCACHE:-}" ] && [ -f "$okfile" ] && [ "$(cat "$okfile")" = "$stamp" ]; then
        echo "✅ Clippy already passed in local gate for this exact diff — skipping pre-push rerun."
    else
        # The crates the push touches and their dependents - the same set, and the
        # same command line, as `susi workflow finish`'s gate, which has just linted
        # it: this run is then a cache hit. `--workspace` here compiled every other
        # crate's test targets as well, a cold build the gate never needed. A
        # workspace-wide input (lockfile, toolchain, root build.rs) is `ALL` and keeps
        # the whole-workspace lint. Plain cargo: it builds into this worktree's
        # own target, so it lints this branch's code. A worktree whose target/
        # is still linked to the clone's old shared one, where a sibling's
        # build can stand in for this branch's, gets its own first (the link
        # only is removed; scripts/seed-target.sh does nothing to a target
        # that holds a build, and waits for a copy a hook is still making).
        top=$(git rev-parse --show-toplevel)
        guard=
        if [ -f "$top/scripts/seed-target.sh" ]; then
            "${BASH:-bash}" "$top/scripts/seed-target.sh" "$top" </dev/null || true
        elif [ -x "$top/scripts/target-guard.sh" ]; then
            # For one release: a worktree whose branch predates the seeding
            # (no seed-target.sh until it merges origin/main) and runs this
            # hook through the clone's hooksPath still builds in the shared
            # target. Its own guard holds that target through clippy, as the
            # hook it carries does, so a sibling's build of a crate cannot
            # stand in for this branch's; the EXIT trap lets go on any exit.
            guard="$top/scripts/target-guard.sh"
            "$guard" --hold $$ >/dev/null
            trap '"$guard" --release $$ >/dev/null 2>&1 || true' EXIT
        fi
        LINT_PKGS=$("$top/scripts/ci-changed-crates.sh" --dependents)
        if [ "$LINT_PKGS" = ALL ] || [ -z "$LINT_PKGS" ]; then
            cargo clippy --workspace --all-targets --locked -- -D warnings
        else
            # shellcheck disable=SC2046 - one `-p` per word is the point.
            cargo clippy --locked --all-targets $(printf ' -p %s' $LINT_PKGS) -- -D warnings
        fi
        clippy_status=$?
        if [ -n "$guard" ]; then "$guard" --release $$; fi
        if [ "$clippy_status" -ne 0 ]; then
            echo "❌ Compliance Violation: Clippy found warnings/errors."
            echo "👉 Fix the clippy issues before pushing."
            exit 1
        fi
    fi

    # `admin audit` runs static compliance analysis - fast and reliable when
    # already compiled, but compiling all dependencies from scratch takes
    # too long for a pre-push hook. Skip it entirely - CI's Test workflow
    # will still verify this push independently on a clean runner.
    echo "- Skipping SUSI Mandate Compliance Auditor (CI will verify independently)..."
    echo "    To run manually: cargo run --release -- admin audit"
else
    echo "⏭️ No Rust/Cargo files in this push, skipping Clippy and Audit checks."
fi

# Documentation-alignment safety net only - not a version-bump requirement.
# In normal operation this can't drift: the only thing that ever changes
# the version is `admin release --cut`, which syncs docs to it atomically
# in the same commit. A mismatch here means someone hand-edited Cargo.toml's
# version outside that path; warn loudly rather than silently rewriting
# files mid-push (which would need its own commit anyway) or blocking an
# otherwise-unrelated push on it.
LOCAL_VERSION=$(grep '^version =' Cargo.toml | head -n 1 | cut -d '"' -f 2)
README_VERSION=$(grep 'badge/version-v' README.md | sed -n 's/.*version-v\([0-9.]*\)-.*/\1/p')
if [[ "$LOCAL_VERSION" != "$README_VERSION" ]]; then
    echo "⚠️  README.md version ($README_VERSION) does not match Cargo.toml ($LOCAL_VERSION)."
    echo "    Run 'cargo run -- admin sync', commit the result, and push again."
fi

echo "✅ SUSI Compliance Check Passed."
exit 0
