#!/usr/bin/env bash
# Mandates 49/50 (Worktree Workflow, Task Queue) enforcement. Called by pre-commit,
# pre-merge-commit and pre-push:  workflow-guard <commit|merge|push>
#
#   commit  — refuse in the primary checkout, and refuse plain commits on main
#   merge   — refuse in the primary checkout (merging into main is allowed)
#   push    — refuse deleting, force-pushing or non-fast-forwarding main;
#             refuse a feature branch that is behind origin/main (sync-before-push);
#             refuse a branch whose commits are not tied to claimed/closed tasks
#
# Escape hatches (deliberate, visible, never the default):
#   SUSI_ALLOW_PRIMARY=1  commit in the primary checkout
#   SUSI_ALLOW_MAIN=1     plain commit on main
#   SUSI_ALLOW_FORCE=1    non-fast-forward push of main
stage=${1:-commit}

primary_checkout() {
    local gd cd
    gd=$(cd "$(git rev-parse --git-dir)" && pwd -P)
    cd=$(cd "$(git rev-parse --git-common-dir)" && pwd -P)
    [ "$gd" = "$cd" ]
}

case "$stage" in
commit | merge)
    if primary_checkout && [ -z "${SUSI_ALLOW_PRIMARY:-}" ]; then
        cat >&2 <<MSG
❌ Mandate 49: do not commit in the primary checkout.
   Every agent/user works in its own worktree on its own branch:
       scripts/susi-worktree.sh             # no name needed; prints `cd <path>` — or: susi workflow start
   (override, knowingly: SUSI_ALLOW_PRIMARY=1 git commit ...)
MSG
        exit 1
    fi
    if [ "$stage" = commit ]; then
        branch=$(git symbolic-ref -q --short HEAD || true)
        if [ "$branch" = main ] && [ -z "${SUSI_ALLOW_MAIN:-}" ]; then
            echo "❌ Mandate 49: no direct commits on main. Commit on your branch, then merge origin/main and push." >&2
            echo "   (override, knowingly: SUSI_ALLOW_MAIN=1)" >&2
            exit 1
        fi
    fi
    ;;
push)
    zero=0000000000000000000000000000000000000000
    root=$(git rev-parse --show-toplevel)
    fetched=0
    while read -r _lref lsha rref rsha; do
        # Mandates 49/50: sync-before-push — a feature branch must contain
        # origin/main before it is pushed (atomic per-task loop).
        case "$rref" in
        refs/heads/main) ;;
        refs/heads/*)
            if [ "$fetched" = 0 ]; then
                # Never judge code freshness against a cached tracking ref.
                git fetch --quiet origin || { echo "Cannot verify origin/main; push refused." >&2; exit 1; }
                fetched=1
            fi
            if [ "$lsha" != "$zero" ] && git rev-parse --verify --quiet origin/main >/dev/null; then
                behind=$(git rev-list --count "$lsha"..origin/main 2>/dev/null || echo 0)
                if [ "${behind:-0}" -gt 0 ]; then
                    echo "❌ Mandate 49/50: branch is $behind commit(s) behind origin/main — sync before push." >&2
                    echo "   git fetch origin && git merge origin/main" >&2
                    echo "   then push; sync again before the next claim." >&2
                    exit 1
                fi
            fi
            # Mandates 50/51: every commit on a pushed branch belongs to a task
            # this branch claimed (the same script CI runs server-side; the
            # branch is passed so a claim held elsewhere is refused).
            if [ "$lsha" != "$zero" ] && [ -x "$root/scripts/check-workflow-compliance.sh" ]; then
                base=origin/main
                git rev-parse --verify --quiet "$base" >/dev/null || base=$(git rev-list --max-parents=0 "$lsha" | tail -1)
                "$root/scripts/check-workflow-compliance.sh" "$base" "$lsha" origin "${lref#refs/heads/}" || exit 1
            fi
            continue
            ;;
        *) continue ;;
        esac
        if [ "$lsha" = "$zero" ]; then
            echo "❌ Mandate 49: deleting main is forbidden." >&2
            exit 1
        fi
        [ "$rsha" = "$zero" ] && continue
        if ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null && [ -z "${SUSI_ALLOW_FORCE:-}" ]; then
            echo "❌ Mandate 49: push to main must be a fast-forward (would drop ${rsha:0:8})." >&2
            echo "   git fetch && git merge origin/main, cargo check, push. Never force-push main." >&2
            exit 1
        fi
    done
    ;;
*)
    echo "workflow-guard: unknown stage '$stage'" >&2
    exit 2
    ;;
esac
exit 0
