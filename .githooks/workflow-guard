#!/bin/sh
# Mandates 49/50 (Worktree Workflow, Task Queue) enforcement. Called by pre-commit,
# pre-merge-commit and pre-push:  workflow-guard <commit|merge|push>
#
# The rules are susi's: `susi workflow guard` (crates/susi-gawd/src/admin/guard.rs).
#   commit  — refuse in the primary checkout, and refuse plain commits on main
#   merge   — refuse in the primary checkout (merging into main is allowed)
#   push    — refuse deleting, force-pushing or non-fast-forwarding main, and a
#             non-fast-forward push of any other branch; refuse a feature branch
#             that is behind origin/main (sync-before-push); fetch branch, claim
#             and close refs in one round trip (what scripts/fetch-workflow-refs.sh
#             does for CI) and run scripts/check-workflow-compliance.sh on that
#             snapshot (SUSI_WORKFLOW_REFS_FETCHED=1), which refuses a commit not
#             tied to a claimed or closed task.
# Escape hatches (deliberate, visible, never the default): SUSI_ALLOW_PRIMARY=1,
# SUSI_ALLOW_MAIN=1, SUSI_ALLOW_FORCE=1.
#
# Git for Windows runs hooks through its own sh.exe whatever the host has, so this
# stub is the shell left on the hook path. It needs sh and git, nothing else: no
# coreutils, jq or flock. run-susi picks the susi that has the subcommand.
exec "$(dirname "$0")/run-susi" workflow guard "$@"
