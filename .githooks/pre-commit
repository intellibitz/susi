#!/usr/bin/env bash
# 🛡️ SUSI Pre-Commit Compliance Hook

# Fast path: only check if relevant files are staged
STAGED_RUST_FILES=$(git diff --cached --name-only | grep -E '\.rs$|^Cargo\.toml$|^Cargo\.lock$')

if [ -z "$STAGED_RUST_FILES" ]; then
    echo "⏭️ No Rust/Cargo files staged, skipping format check."
    exit 0
fi

echo "🛡️ Running SUSI Code Compliance Checks..."

echo "- Checking Rustfmt..."
cargo fmt --all -- --check
if [ $? -ne 0 ]; then
    echo "❌ Compliance Violation: Code formatting is not compliant."
    echo "👉 Run 'cargo fmt --all' to fix."
    exit 1
fi

echo "✅ SUSI Compliance Pre-Commit Check Passed."
echo "ℹ️ Note: Clippy and Audit checks have been deferred to pre-push."
exit 0
