# Minimal runtime image for the susi daemon. Build context is the repo
# root; the release binary is produced by the normal release flow, so this
# image packages it rather than rebuilding inside Docker.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY target/release/susi /usr/local/bin/susi
ENV SUSI_HOME=/susi \
    SUSI_UNATTENDED=1 \
    GIT_TERMINAL_PROMPT=0 \
    GCM_INTERACTIVE=never \
    SSH_ASKPASS_REQUIRE=never \
    CREDENTIALS_DIRECTORY=/run/secrets \
    SUSI_CREDENTIALS_DIRECTORY=/run/secrets
VOLUME ["/susi"]
EXPOSE 9090
ENTRYPOINT ["susi"]
CMD ["daemon-start", "--workspace", "/susi"]
