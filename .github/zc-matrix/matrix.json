{
  "comment": "Fresh-environment matrix: the clean-HOME journey (tests/zc_fresh_home.rs + zc_time_to_answer.rs) runs per profile on a clean container; the check script validates this definition's shape and expected outcomes.",
  "version": 1,
  "journey": {
    "script": "cargo test --test zc_time_to_answer --test zc_fresh_home --test zc_hooks_on_clone",
    "budget_seconds": 900
  },
  "profiles": [
    {
      "id": "cpu-only",
      "image": "rust:bookworm",
      "memory_mb": 4096,
      "gpus": 0,
      "env": {"SUSI_PROFILE": "cpu"},
      "expect": {
        "first_answer": true,
        "local_model": "qwen2.5-0.5b-instruct-q4",
        "offline_fallback": false
      }
    },
    {
      "id": "emulated-gpu",
      "image": "rust:bookworm",
      "memory_mb": 8192,
      "gpus": 1,
      "emulated": true,
      "env": {"SUSI_PROFILE": "emulated-gpu"},
      "expect": {
        "first_answer": true,
        "local_model": "qwen2.5-3b-instruct-q4",
        "offline_fallback": false
      }
    },
    {
      "id": "low-memory",
      "image": "rust:bookworm",
      "memory_mb": 1536,
      "gpus": 0,
      "env": {"SUSI_PROFILE": "low-memory"},
      "expect": {
        "first_answer": true,
        "local_model": "qwen2.5-0.5b-instruct-q4",
        "offline_fallback": true
      }
    }
  ]
}
