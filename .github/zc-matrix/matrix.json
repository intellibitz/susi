{
  "comment": "Fresh-environment matrix: per-OS lifecycle smoke. Each profile runs the installer/lifecycle journey (tests/zc_platform_installers.rs + tests/vc_201_098_mastery.rs) under a clean HOME on that OS family; the check script validates this definition's shape and that the workflow runs every declared profile.",
  "version": 2,
  "journey": {
    "script": "cargo test --test zc_platform_installers --test vc_201_098_mastery --locked",
    "budget_seconds": 900
  },
  "profiles": [
    {
      "id": "linux-cpu",
      "runner": "ubuntu-latest",
      "env": {"SUSI_PROFILE": "linux-cpu"},
      "expect": {
        "installer_plan": true,
        "lifecycle_smoke": true
      }
    },
    {
      "id": "macos-cpu",
      "runner": "macos-latest",
      "env": {"SUSI_PROFILE": "macos-cpu"},
      "expect": {
        "installer_plan": true,
        "lifecycle_smoke": true
      }
    },
    {
      "id": "windows-cpu",
      "runner": "windows-latest",
      "env": {"SUSI_PROFILE": "windows-cpu"},
      "expect": {
        "installer_plan": true,
        "lifecycle_smoke": true
      }
    }
  ]
}
