    "body": "{\"name\":\"susi-gawd\",\"description\":\"SUSI GAWD: AI agent orchestrator and swarm supervisor\",\"supportedInterfaces\":[{\"url\":\"/\",\"protocolBinding\":\"JSONRPC\",\"protocolVersion\":\"1.0\"}],\"version\":\"<engine-version>\",\"documentationUrl\":\"https://github.com/intellibitz/susi\",\"capabilities\":{\"streaming\":true,\"pushNotifications\":true},\"securitySchemes\":{\"bearer\":{\"http\":{\"scheme\":\"Bearer\"}}},\"securityRequirements\":[{\"schemes\":{\"bearer\":[]}}],\"defaultInputModes\":[\"text/plain\"],\"defaultOutputModes\":[\"text/plain\"],\"skills\":[{\"id\":\"missions\",\"name\":\"missions\",\"description\":\"Run a natural-language goal as a GAWD mission: planned, dispatched to tools and agents, and answered only with evidence-gated results.\",\"tags\":[\"missions\",\"orchestration\"],\"examples\":[\"Summarize the open tasks in this workspace\"],\"inputModes\":[\"text/plain\"],\"outputModes\":[\"text/plain\"]},{\"id\":\"agents\",\"name\":\"agents\",\"description\":\"Missions that hand work to the external task executors installed on this host (the agents managed by `susi agents`; MCP tools `agents_list`, `agents_run`).\",\"tags\":[\"agents\",\"delegation\"],\"examples\":[\"Use an installed coding agent to fix the failing test\"],\"inputModes\":[\"text/plain\"],\"outputModes\":[\"text/plain\"]},{\"id\":\"frameworks\",\"name\":\"frameworks\",\"description\":\"Missions that run through the agent frameworks/engines installed on this host, such as LangGraph or CrewAI (managed by `susi frameworks`; MCP tools `frameworks_list`, `frameworks_run`).\",\"tags\":[\"frameworks\",\"engines\"],\"inputModes\":[\"text/plain\"],\"outputModes\":[\"text/plain\"]},{\"id\":\"models\",\"name\":\"models\",\"description\":\"Missions answered through GEMI model routing: local open-weight models and configured cloud providers, chosen by placement policy.\",\"tags\":[\"models\",\"inference\"],\"inputModes\":[\"text/plain\"],\"outputModes\":[\"text/plain\"]},{\"i