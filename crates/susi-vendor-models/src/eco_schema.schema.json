{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.intellibitz.dev/susi/eco-schema-v1.json",
  "title": "SUSI ecosystem knowledge base",
  "description": "eco-schema/v1: a typed graph of the cloud AI ecosystem. Entities are components (models, engines, runtimes, registries, MCP servers/clients, extensions, services), vendors, standards, protocols, spec-versions and capabilities. Relations are typed edges between them. Every fact carries provenance: source, spec_version, retrieved date and confidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entities", "relations"],
  "properties": {
    "version": { "const": "eco-schema/v1" },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "date": {
      "type": "string",
      "description": "ISO 8601 calendar date, YYYY-MM-DD.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "spec_version", "retrieved", "confidence"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "URL or citation of the official machine-readable spec or primary source this fact came from."
        },
        "spec_version": {
          "type": "string",
          "minLength": 1,
          "description": "Version of the specification the fact is stated against; \"n/a\" when the fact is unversioned."
        },
        "retrieved": { "$ref": "#/$defs/date" },
        "confidence": {
          "enum": ["verified", "reported", "inferred", "speculative"]
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "name", "category", "provenance"],
      "properties": {
        "kind": { "const": "component" },
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "model",
            "inference-engine",
            "serving-gateway",
            "agent-runtime",
            "agent-framework",
            "model-registry",
            "mcp-server",
            "mcp-client",
            "extension",
            "cli-tool",
            "service"
          ]
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "name", "home", "provenance"],
      "properties": {
        "kind": { "const": "vendor" },
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "home": {
          "type": "string",
          "minLength": 1,
          "description": "Vendor home page or primary developer portal."
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "name", "body", "provenance"],
      "properties": {
        "kind": { "const": "standard" },
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "body": {
          "type": "string",
          "minLength": 1,
          "description": "Organisation that publishes the standard (SDO, vendor or foundation)."
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "name", "transports", "provenance"],
      "properties": {
        "kind": { "const": "protocol" },
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "transports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["http", "http-sse", "websocket", "grpc", "stdio", "in-process"]
          }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "specVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "name", "version", "provenance"],
      "properties": {
        "kind": { "const": "spec-version" },
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Version label as published by the spec's body (e.g. \"2025-06-18\", \"3.1.0\")."
        },
        "released": {
          "$ref": "#/$defs/date",
          "description": "Publication date of this spec version, when known."
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "name", "class", "provenance"],
      "properties": {
        "kind": { "const": "capability" },
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "class": {
          "enum": [
            "text-generation",
            "tool-calling",
            "structured-output",
            "streaming",
            "embeddings",
            "vision",
            "audio",
            "reasoning",
            "batch",
            "realtime",
            "prompt-caching",
            "files",
            "moderation",
            "agent-delegation",
            "resource-access",
            "discovery"
          ]
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "entity": {
      "oneOf": [
        { "$ref": "#/$defs/component" },
        { "$ref": "#/$defs/vendor" },
        { "$ref": "#/$defs/standard" },
        { "$ref": "#/$defs/protocol" },
        { "$ref": "#/$defs/specVersion" },
        { "$ref": "#/$defs/capability" }
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from", "to", "provenance"],
      "properties": {
        "kind": {
          "enum": [
            "provides",
            "publishes",
            "implements",
            "implements-version",
            "version-of",
            "has-capability",
            "depends-on",
            "compatible-with",
            "supersedes"
          ]
        },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
