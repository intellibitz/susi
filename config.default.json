  "beacon_interval_secs": 30,
  "gemi_port": 9091,
  "default_fallback_model": {
    "hf_file": "qwen2.5-0.5b-instruct-q4_k_m.gguf",
    "hf_repo": "Qwen/Qwen2.5-0.5B-Instruct-GGUF"
  },
  "udp_discovery_port": 9092,
  "model_scoring_heuristics": {
    "native_candle_bonus": 15.0,
    "size_gb_multipliers": {
      "0.5b": 0.5,
      "1.5b": 1.0,
      "13b": 10.0,
      "14b": 10.0,
      "32b": 20.0,
      "33b": 20.0,
      "70b": 40.0,
      "72b": 40.0,
      "7b": 4.5,
      "8b": 5.0
    },
    "system_ram_buffer_gb": 4.0
  },
  "trust_level": "Balanced",
  "mcp_registry_url": "https://raw.githubusercontent.com/intellibitz/susi/main/registry.json",
  "reflex_training_threshold": 50,
  "gmcp_port": 9090,
  "local_scan_paths": [],
  "execution_lease_secs": 30
