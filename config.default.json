{
  "susi_repo": "intellibitz/susi",
  "agent_rank_threshold": 0.6,
  "alpha_weights_url": "https://huggingface.co/intellibitz/susi-alpha/resolve/main/susi-alpha.safetensors",
  "alpha_weights_filename": "susi-alpha.safetensors",
  "tokenizer_filename": "tokenizer.json",
  "hf_base_url": "https://huggingface.co",
  "max_concurrent_agents": 32,
  "cloud_scout_timeout_secs": 8,
  "auto_download_models": true,
  "default_model": "susi-alpha",
  "discoverable_assets": [
    {
      "name": "SusiReflexCloud-v2",
      "provider": "SUSI Hub",
      "tier": "Tier 0: SUSI-Alpha (Reflex)",
      "url": "https://susi.ai/reflex/v2"
    },
    {
      "name": "DistilledRouter-1B",
      "provider": "HuggingFace",
      "tier": "Tier 0: SUSI-Alpha (Reflex)",
      "url": "https://huggingface.co/susi/distilled-router"
    }
  ],
  "governance": {
    "critical_system_paths": [
      "/etc/passwd",
      "/etc/shadow",
      "/boot",
      "/proc",
      "/sys",
      "/dev"
    ],
    "destructive_commands": [
      "rm -rf /",
      "rm -rf $HOME",
      "rm -rf ~",
      "mkfs",
      "dd if=",
      "> /dev/sda",
      ":(){ :|:& };:",
      "chmod -R 777 /",
      "chown -R",
      "shred"
    ],
    "exfiltration_vectors": [
      "curl -x post",
      "wget --post-data",
      "netcat",
      "nc -e",
      "/dev/tcp/",
      "base64 | curl"
    ],
    "secret_tokens": [
      "sk-",
      "ghp_",
      "AIza",
      "xoxb-",
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "-----BEGIN RSA PRIVATE KEY-----"
    ]
  },
  "gmcp_http_port": 9093,
  "default_engine": "susi-offline",
  "admin_command_routing": {
    "audit": [
      [
        "audit"
      ]
    ],
    "deep_scan": [
      [
        "deep-scan"
      ]
    ],
    "identity": [
      [
        "identity"
      ]
    ],
    "install": [
      [
        "initialize"
      ],
      [
        "install"
      ]
    ],
    "list_models": [
      [
        "list",
        "models"
      ]
    ],
    "release": [
      [
        "release"
      ]
    ],
    "status_health": [
      [
        "status"
      ],
      [
        "health"
      ]
    ],
    "sync": [
      [
        "sync"
      ]
    ],
    "uninstall": [
      [
        "remove"
      ],
      [
        "uninstall"
      ]
    ],
    "verify": [
      [
        "verify"
      ]
    ],
    "version": [
      [
        "version"
      ]
    ]
  },
  "model_ladder": [
    {
      "hf_file": "qwen2.5-1.5b-instruct-q4_k_m.gguf",
      "hf_repo": "Qwen/Qwen2.5-1.5B-Instruct-GGUF",
      "label": "1.5B Parameters (Fast Local Edge)",
      "min_ram_gb": 0,
      "step": 1
    },
    {
      "hf_file": "Qwen2.5-7B-Instruct-Q4_K_M.gguf",
      "hf_repo": "bartowski/Qwen2.5-7B-Instruct-GGUF",
      "label": "7B Parameters (Mid-Range Desktop)",
      "min_ram_gb": 8,
      "step": 2
    },
    {
      "hf_file": "Qwen2.5-14B-Instruct-Q4_K_M.gguf",
      "hf_repo": "bartowski/Qwen2.5-14B-Instruct-GGUF",
      "label": "14B Parameters (High-Accuracy Workstation)",
      "min_ram_gb": 16,
      "step": 3
    },
    {
      "hf_file": "Qwen2.5-32B-Instruct-Q4_K_M.gguf",
      "hf_repo": "bartowski/Qwen2.5-32B-Instruct-GGUF",
      "label": "32B Parameters (High-End Workstation)",
      "min_ram_gb": 32,
      "step": 4
    },
    {
      "hf_file": "Qwen2.5-72B-Instruct-Q4_K_M.gguf",
      "hf_repo": "bartowski/Qwen2.5-72B-Instruct-GGUF",
      "label": "72B Parameters (Ultra-Capacity Workstation)",
      "min_ram_gb": 64,
      "step": 5
    }
  ],
  "max_stdin_size_bytes": 104857600,
  "stdin_timeout_secs": 120,
  "bootstrap_mcp_servers": [
    {
      "category": "database",
      "description": "Standard Protocol SQL Database Server",
      "latency_ms": 10,
      "name": "database",
      "package": "mcp-server-postgres",
      "trust_score": 0.95
    },
    {
      "category": "search",
      "description": "Standard Protocol Web Search Server",
      "latency_ms": 50,
      "name": "search",
      "package": "mcp-server-search",
      "trust_score": 0.9
    },
    {
      "category": "vcs",
      "description": "Standard Protocol Version Control Server",
      "latency_ms": 30,
      "name": "vcs",
      "package": "mcp-server-github",
      "trust_score": 0.92
    }
  ],
  "admin_pulses": {
    "audit_deps_pulse": "admin pulse: run dependency security audit",
    "audit_pulse": "admin pulse: perform compliance audit and technical verification",
    "deep_scan_pulse": "admin pulse: perform parallel deep-scan of substrate home for local models and register them",
    "install_pulse": "admin pulse: initialize sandboxed .susi environment and provision weights",
    "lint_pulse": "admin pulse: run linting and static analysis (clippy)",
    "mcp_scout_pulse": "admin pulse: perform autonomous web-scouting of open-source MCP servers and benchmark them",
    "release_pulse": "admin pulse: execute full release orchestration sequence",
    "select_model_pulse": "admin pulse: select and override active model substrate to {}",
    "uninstall_pulse": "admin pulse: remove and clean up sandboxed .susi environment",
    "verify_pulse": "admin pulse: verify version alignment across manifest and documents"
  },
