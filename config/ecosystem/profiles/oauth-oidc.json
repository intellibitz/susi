  "request_shapes": [
    {
      "name": "bearer-usage",
      "format": "http",
      "fields": [
        "Authorization: Bearer <at>",
        "WWW-Authenticate challenge on 401",
        "scope parameters",
        "expires_in handling"
      ],
      "notes": "cloud AI APIs use bearer for workforce/Entra/IAM tokens"
    },
    {
      "name": "discovery",
      "format": "http",
      "fields": [
        "GET /.well-known/openid-configuration",
        "jwks_uri -> signing keys",
        "issuer validation"
      ],
      "notes": "OIDC discovery resolves token validation inputs"
    },
    {
      "name": "jwt",
      "format": "text",
      "fields": [
        "header.payload.signature",
        "claims iss|aud|exp|sub|scope|roles",
        "JWKS rotation via kid"
      ],
      "notes": "JWT is the token format, not the grant"
    }
  ],
