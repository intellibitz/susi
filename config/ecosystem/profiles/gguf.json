  "request_shapes": [
    {
      "name": "header",
      "format": "binary",
      "fields": [
        "magic 'GGUF' u32le",
        "version u32",
        "tensor_count u64",
        "metadata_kv_count u64"
      ],
      "notes": "little-endian throughout"
    },
    {
      "name": "metadata",
      "format": "binary",
      "fields": [
        "general.architecture",
        "general.name",
        "general.file_type",
        "tokenizer.ggml.model|tokens|scores|merges|pre",
        "{arch}.context_length|embedding_length|block_count|attention.*",
        "alignment (default 32)"
      ],
      "notes": "typed values: string/uint/int/float/bool/array"
    },
    {
      "name": "tensor-data",
      "format": "binary",
      "fields": [
        "tensor infos {name,n_dims,dims,type,offset}",
        "quant types: F16/BF16/Q4_0/Q4_K_M/IQ2_XXS/...",
        "pad to general.alignment"
      ],
      "notes": "mmap-aligned so engines map weights without copying"
    }
  ],
