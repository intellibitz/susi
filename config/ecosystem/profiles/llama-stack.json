    }
  ],
  "capabilities": [
    "cap-chat",
    "cap-tool-calling",
    "cap-agent-delegation",
    "cap-resource-access",
    "cap-moderation",
    "cap-embeddings",
    "cap-streaming"
  ],
  "deviations": [],
