  "max_stdin_size_bytes": 104857600,
  "stdin_timeout_secs": 120,
  "bootstrap_mcp_servers": [
    {
      "category": "database",
      "description": "Standard Protocol SQL Database Server",
      "latency_ms": 10,
      "name": "database",
      "package": "mcp-server-postgres",
      "trust_score": 0.95
    },
    {
      "category": "search",
      "description": "Standard Protocol Web Search Server",
      "latency_ms": 50,
      "name": "search",
      "package": "mcp-server-search",
      "trust_score": 0.9
    },
    {
      "category": "vcs",
      "description": "Standard Protocol Version Control Server",
      "latency_ms": 30,
      "name": "vcs",
      "package": "mcp-server-github",
      "trust_score": 0.92
    }
  ],
  "admin_pulses": {
    "audit_deps_pulse": "admin pulse: run dependency security audit",
    "audit_pulse": "admin pulse: perform compliance audit and technical verification",
    "deep_scan_pulse": "admin pulse: perform parallel deep-scan of substrate home for local models and register them",
    "install_pulse": "admin pulse: initialize sandboxed .susi environment and provision weights",
    "lint_pulse": "admin pulse: run linting and static analysis (clippy)",
    "mcp_scout_pulse": "admin pulse: perform autonomous web-scouting of open-source MCP servers and benchmark them",
    "select_model_pulse": "admin pulse: select and override active model substrate to {}",
    "uninstall_pulse": "admin pulse: remove and clean up sandboxed .susi environment",
    "verify_pulse": "admin pulse: verify version alignment across manifest and documents"
  },
  "intent_classify": {
    "query_exact": [
