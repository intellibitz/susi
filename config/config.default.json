  "governance": {
    "critical_system_paths": [
      "/etc/passwd",
      "/etc/shadow",
      "/boot",
      "/proc",
      "/sys",
      "/dev"
    ],
    "destructive_commands": [
      "rm -rf /",
      "rm -rf $HOME",
      "rm -rf ~",
      "mkfs",
      "dd if=",
      "> /dev/sda",
      ":(){ :|:& };:",
      "chmod -R 777 /",
      "chown -R",
      "shred"
    ],
    "exfiltration_vectors": [
      "curl -x post",
      "wget --post-data",
      "netcat",
      "nc -e",
      "/dev/tcp/",
      "base64 | curl"
    ],
    "secret_tokens": [
      "sk-",
      "ghp_",
      "AIza",
      "xoxb-",
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "-----BEGIN RSA PRIVATE KEY-----"
    ]
  },
  "gmcp_http_port": 9093,
  "allow_origin": "*",
  "max_rpc_body_bytes": 10485760,
  "api_auth_token": "",
  "rate_limit_per_minute": 120,
  "default_engine": "susi-offline",
  "admin_command_routing": {
