{
  "susi_repo": "intellibitz/susi",
  "agent_rank_threshold": 0.6,
  "alpha_weights_url": "https://huggingface.co/intellibitz/susi-alpha/resolve/main/susi-alpha.safetensors",
  "alpha_weights_filename": "susi-alpha.safetensors",
  "tokenizer_filename": "tokenizer.json",
  "hf_base_url": "https://huggingface.co",
  "max_concurrent_agents": 32,
  "cloud_scout_timeout_secs": 8,
  "model_provisioning_wait_secs": 1800,
  "capability_rediscovery_secs": 60,
  "auto_download_models": true,
  "default_model": "susi-alpha",
  "discoverable_assets": [
    {
      "name": "SusiReflexCloud-v2",
      "provider": "SUSI",
      "tier": "Tier 0: SUSI-Alpha (Reflex)",
      "url": "https://github.com/intellibitz/susi"
    },
    {
      "name": "DistilledRouter-1B",
      "provider": "SUSI",
      "tier": "Tier 0: SUSI-Alpha (Reflex)",
      "url": "https://github.com/intellibitz/susi"
    }
  ],
  "governance": {
    "critical_system_paths": [
      "/etc/passwd",
      "/etc/shadow",
      "/boot",
      "/proc",
      "/sys",
      "/dev"
    ],
    "destructive_commands": [
      "rm -rf /",
      "rm -rf $HOME",
      "rm -rf ~",
      "mkfs",
      "dd if=",
      "> /dev/sda",
      ":(){ :|:& };:",
      "chmod -R 777 /",
      "chown -R",
      "shred"
    ],
    "exfiltration_vectors": [
      "curl -x post",
      "wget --post-data",
      "netcat",
      "nc -e",
      "/dev/tcp/",
      "base64 | curl"
    ],
    "secret_tokens": [
      "sk-",
      "ghp_",
      "AIza",
      "xoxb-",
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "-----BEGIN RSA PRIVATE KEY-----"
    ]
  },
  "gmcp_http_port": 9093,
  "a2a_http_port": 9094,
  "bind_address": "127.0.0.1",
  "port_offset": 0,
  "tls_cert_path": "",
  "tls_key_path": "",
  "https_only": false,
  "openrouter_http_referer": "https://github.com/intellibitz/susi",
  "openrouter_app_title": "SUSI",
  "allow_origin": "*",
  "max_rpc_body_bytes": 10485760,
  "rate_limit_per_minute": 120,
  "default_engine": "susi-offline",
  "admin_command_routing": {
    "audit": [
      [
        "audit"
      ]
    ],
    "deep_scan": [
      [
        "deep-scan"
      ]
    ],
    "identity": [
      [
        "identity"
      ]
    ],
    "install": [
      [
        "initialize"
      ],
      [
        "install"
      ]
    ],
    "list_models": [
      [
        "list",
        "models"
      ]
    ],
    "release": [
      [
        "release"
      ]
    ],
    "status_health": [
      [
        "status"
      ],
      [
        "health"
      ]
    ],
    "sync": [
      [
        "sync"
      ]
    ],
    "uninstall": [
      [
        "remove"
      ],
      [
        "uninstall"
      ]
    ],
    "verify": [
      [
        "verify"
      ]
    ],
    "version": [
      [
        "version"
      ]
    ]
  },
  "model_ladder": [],
  "model_lifecycle": {
    "download_attempts": 4,
    "download_timeout_secs": 60,
    "max_parallel_downloads": 2,
    "discovery_refresh_secs": 21600,
    "discovery_retry_secs": 300,
    "discovery_limit": 24,
    "max_ladder_tiers": 5,
    "ladder_size_ratio": 1.6,
    "memory_overhead_ratio": 1.25,
    "prefetch_tiers": 3,
    "failure_cooldown_secs": 300
  },
  "max_stdin_size_bytes": 104857600,
  "stdin_timeout_secs": 120,
  "bootstrap_mcp_servers": [
    {
      "category": "fs",
      "description": "Sandboxed filesystem read/write for autonomous agents",
      "latency_ms": 20,
      "name": "filesystem",
      "package": "@modelcontextprotocol/server-filesystem",
      "trust_score": 0.95
    },
    {
      "category": "exec",
      "description": "Host shell / command execution for scripts and tests",
      "latency_ms": 40,
      "name": "bash",
      "package": "mcp-server-commands",
      "trust_score": 0.85
    },
    {
      "category": "browser",
      "description": "Playwright headless browser for UI interaction (pair with chrome-devtools)",
      "latency_ms": 80,
      "name": "browser",
      "package": "@playwright/mcp",
      "trust_score": 0.92
    },
    {
      "category": "browser",
      "description": "Chrome DevTools live inspection for agent debugging",
      "latency_ms": 80,
      "name": "chrome-devtools",
      "package": "chrome-devtools-mcp",
      "trust_score": 0.92
    },
    {
      "category": "docs",
      "description": "Context7 version-specific library documentation",
      "latency_ms": 60,
      "name": "context7",
      "package": "@upstash/context7-mcp",
      "trust_score": 0.92
    },
    {
      "category": "vcs",
      "description": "GitHub official MCP (issues, PRs, repo search)",
      "latency_ms": 80,
      "name": "github",
      "package": "ghcr.io/github/github-mcp-server",
      "trust_score": 0.95
    },
    {
      "category": "observability",
      "description": "Sentry error logs for diagnose-and-patch workflows",
      "latency_ms": 80,
      "name": "sentry",
      "package": "@sentry/mcp-server",
      "trust_score": 0.9
    },
    {
      "category": "search",
      "description": "Brave Search live web querying",
      "latency_ms": 80,
      "name": "brave-search",
      "package": "@brave/brave-search-mcp-server",
      "trust_score": 0.9
    },
    {
      "category": "database",
      "description": "Postgres MCP (official @modelcontextprotocol/server-postgres)",
      "latency_ms": 10,
      "name": "postgres",
      "package": "@modelcontextprotocol/server-postgres",
      "trust_score": 0.95
    },
    {
      "category": "vcs",
      "description": "Git MCP for local repository operations",
      "latency_ms": 30,
      "name": "git",
      "package": "mcp-server-git",
      "trust_score": 0.92
    }
  ],
  "admin_pulses": {
    "audit_deps_pulse": "admin pulse: run dependency security audit",
    "audit_pulse": "admin pulse: perform compliance audit and technical verification",
    "deep_scan_pulse": "admin pulse: perform parallel deep-scan of substrate home for local models and register them",
    "install_pulse": "admin pulse: initialize sandboxed .susi environment and provision weights",
    "lint_pulse": "admin pulse: run linting and static analysis (clippy)",
    "mcp_scout_pulse": "admin pulse: perform autonomous web-scouting of open-source MCP servers and benchmark them",
    "select_model_pulse": "admin pulse: select and override active model substrate to {}",
    "uninstall_pulse": "admin pulse: remove and clean up sandboxed .susi environment",
    "verify_pulse": "admin pulse: verify version alignment across manifest and documents"
  },
  "intent_classify": {
    "query_exact": [
      "identity",
      "status",
      "models",
      "version",
      "ls",
      "dir"
    ],
    "query_prefixes": [
      "ls ",
      "susi status",
      "susi identity",
      "susi models"
    ],
    "query_contains": [
      "who am i",
      "whoami"
    ],
    "motion_contains": [
      "motion",
      "architecture",
      "hardcode"
    ]
  },
