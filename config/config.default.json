  "crates_io_api_url": "https://crates.io/api/v1/crates",
  "sandbox_image": "alpine:latest",
  "memory_experience_heuristics": {
    "min_output_len": 50,
    "failure_markers": [
      "[FAIL]",
      "error"
    ]
  },
  "eos_token_ids": [
    1,
    2,
    32000,
    151643
  ],
  "max_generation_tokens": 256,
  "gemi_max_concurrent_requests": 4,
  "repeat_penalty": 1.15,
  "repeat_last_n": 64,
  "speculative_decoding_enabled": false,
  "speculative_draft_tokens": 4,
  "kv_cache_capacity_tokens": 8192,
  "axiomatic_risk_patterns": [
    "rm -rf /",
    "drop database",
    "eval(",
    "chmod 777",
    "curl | sh"
  ],
  "model_scan_exclude_dirs": [
