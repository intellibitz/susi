  "model_discovery_exclude_dirs": [
    ".git",
    "node_modules",
    "target",
    "vendor",
    ".cargo",
    ".rustup",
    ".gradle",
    "proc",
    "sys"
  ],
  "home_scan_root_exclude_dirs": [
    "node_modules",
    "target",
    "vendor",
    "proc",
    "sys",
    "dev",
    "Library"
  ],
  "model_file_extensions": [
