    "safetensors",
    "onnx",
    "pt",
    "ckpt"
  ],
  "model_file_min_bytes": 1000000,
  "susi_alpha_default": "susi-alpha",
  "inference_routing": {
    "policy": "auto",
    "local_min_tokens_per_sec": 8.0,
    "local_max_latency_ms": 15000,
    "prefer_cloud_when_cpu_only": true,
    "ask_when_multiple_clouds": true
  },
  "external_peer_agents": [
    {
      "name": "GooseAgent",
      "description": "Block Goose agent CLI (pluggable when driver on PATH / configured).",
      "detect_bins": [
        "goose"
      ],
      "command": "goose",
      "args": [
        "run",
        "{goal}"
      ],
      "timeout_secs": 600,
      "api_key_env": null,
      "protocol": "cli"
    },
    {
      "name": "AmazonQAgent",
      "description": "Amazon Q Developer CLI (pluggable when driver on PATH / configured).",
      "detect_bins": [
        "q"
      ],
      "command": "q",
      "args": [
        "chat",
        "{goal}"
      ],
      "timeout_secs": 600,
      "api_key_env": null,
      "protocol": "cli"
    },
    {
      "name": "ContinueAgent",
      "description": "Continue.dev CLI peer (pluggable when driver on PATH / configured).",
      "detect_bins": [
        "cn",
        "continue"
      ],
      "command": "cn",
      "args": [
        "{goal}"
      ],
      "timeout_secs": 600,
      "api_key_env": null,
      "protocol": "cli"
    }
  ],
  "external_peer_agents_note": "Managed peers (protocol=managed) are derived at runtime from execution-agents.json + agent-engines.json peer_name fields. Only non-managed CLI/HTTP/A2A peers need listing here."
}
