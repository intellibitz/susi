{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intellibitz.com/susi/schemas/roadmap.schema.json",
  "title": "susi/roadmap/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "strategic_priority", "vectors"],
  "properties": {
    "schema": { "const": "susi/roadmap/v1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "strategic_priority": { "type": "string" },
    "target_version": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "vector", "mastery_target", "progress"],
        "properties": {
          "id": { "type": "string", "pattern": "^VC-" },
          "type": { "type": "string" },
          "vector": { "type": "string" },
          "mastery_target": { "type": "string" },
          "progress": { "type": "string" }
        }
      }
    }
  }
}
