{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intellibitz.com/susi/schemas/evidence.schema.json",
  "title": "susi/evidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "entries"],
  "properties": {
    "schema": { "const": "susi/evidence/v1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id_scheme": { "type": "string" },
    "last_verification": { "type": "string" },
    "epistemic_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "milestone", "anchor", "proof"],
        "properties": {
          "id": { "type": "string", "pattern": "^EV-" },
          "type": { "type": "string" },
          "milestone": { "type": "string" },
          "anchor": {
            "type": "object",
            "required": ["label"],
            "properties": {
              "label": { "type": "string" },
              "ref": { "type": ["string", "null"] }
            }
          },
          "proof": { "type": "string" }
        }
      }
    }
  }
}
