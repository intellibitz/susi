#!/usr/bin/env bash
# Prefer a fast linker when available; never fail a host that has only cc.
# Used as rustc's linker via .cargo/config.toml for Linux targets.
#
# rustc on *-linux-gnu passes cc/gcc-style driver args (-Wl,…), not raw ld
# args — so mold/lld must be selected via -fuse-ld on a C compiler driver,
# not by exec'ing mold as if it were ld.
set -euo pipefail

if command -v clang >/dev/null 2>&1; then
    if command -v mold >/dev/null 2>&1; then
        exec clang -fuse-ld=mold "$@"
    fi
    if command -v ld.lld >/dev/null 2>&1 || command -v lld >/dev/null 2>&1; then
        exec clang -fuse-ld=lld "$@"
    fi
fi

if command -v gcc >/dev/null 2>&1; then
    if command -v mold >/dev/null 2>&1; then
        exec gcc -fuse-ld=mold "$@"
    fi
    if command -v ld.lld >/dev/null 2>&1 || command -v lld >/dev/null 2>&1; then
        exec gcc -fuse-ld=lld "$@"
    fi
    exec gcc "$@"
fi

if command -v cc >/dev/null 2>&1; then
    exec cc "$@"
fi

echo "susi .cargo/fast-linker: no C linker found (need clang/gcc/cc)" >&2
exit 1
